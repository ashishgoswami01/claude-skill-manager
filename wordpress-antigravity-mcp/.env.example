# --- WordPress site connection ---
# Base URL of your WordPress site (no trailing slash)
WP_SITE_URL=https://example.com

# WordPress username (the account these credentials belong to)
WP_USERNAME=your-wp-username

# WordPress Application Password
# Create one at: WP Admin -> Users -> Profile -> Application Passwords
# Use the generated password as-is (spaces are fine)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
